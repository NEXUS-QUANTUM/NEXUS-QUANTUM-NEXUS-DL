{
  "name": "NexusDL 2.0 - Moteur universel de téléchargement de scans",
  "short_name": "NexusDL",
  "description": "🧬 NexusDL 2.0 - Téléchargez automatiquement mangas, manhwas, webtoons et doujinshi depuis plus de 50 sites de scan. Interface moderne, téléchargement parallèle, export CBZ, support Playwright.",
  "id": "/?source=pwa",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "theme_color": "#0a0e1a",
  "background_color": "#0a0e1a",
  "categories": [
    "entertainment",
    "books",
    "comics",
    "productivity",
    "utilities"
  ],
  "lang": "fr",
  "dir": "ltr",
  "prefer_related_applications": false,
  "related_applications": [],
  "iarc_rating_id": "",
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "edge_side_panel": {
    "preferred_width": 480
  },
  "protocol_handlers": [
    {
      "protocol": "web+nexusdl",
      "url": "/?url=%s"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [".cbz", ".zip", "application/zip"]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "🔍 Rechercher une série",
      "short_name": "Recherche",
      "description": "Rechercher et analyser une série depuis une URL ou un titre",
      "url": "/search?source=shortcut",
      "icons": [
        {
          "src": "/icons/shortcut-search-96x96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "📚 Ma bibliothèque",
      "short_name": "Bibliothèque",
      "description": "Accéder à vos téléchargements",
      "url": "/library?source=shortcut",
      "icons": [
        {
          "src": "/icons/shortcut-library-96x96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "⏳ File d'attente",
      "short_name": "File",
      "description": "Voir les téléchargements en cours",
      "url": "/queue?source=shortcut",
      "icons": [
        {
          "src": "/icons/shortcut-queue-96x96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "⚙️ Paramètres",
      "short_name": "Paramètres",
      "description": "Configurer l'application",
      "url": "/settings?source=shortcut",
      "icons": [
        {
          "src": "/icons/shortcut-settings-96x96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
