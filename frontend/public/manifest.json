  "file_handlers": [
    {
      "action": "/import",
      "accept": {
        "application/zip": [".cbz", ".zip"],
        "application/x-cbz": [".cbz"]
      },
      "icons": [
        {
          "src": "/icons/file-handler-96x96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "note_taking": {
    "new_note_url": "/notes/new"
  },
  "scope_extensions": [
    {
      "type": "origin",
      "origin": "https://api.mangadex.org"
    }
  ],
