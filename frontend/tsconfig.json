{
  // ==========================================================================
  //  NexusDL 2.0 - TypeScript Configuration
  //  Fichier : frontend/tsconfig.json
  //  Description : Configuration TypeScript complète pour l'application Vue.js 3
  //  Version : 2.0.0
  // ==========================================================================

  "compilerOptions": {
    // ----------------------------------------------------------------------
    //  Options de langage et d'environnement
    // ----------------------------------------------------------------------
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,

    // ----------------------------------------------------------------------
    //  Résolution des modules
    // ----------------------------------------------------------------------
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",

    // ----------------------------------------------------------------------
    //  Contrôle de la qualité du code (strict)
    // ----------------------------------------------------------------------
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": false,
    "exactOptionalPropertyTypes": false,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,

    // ----------------------------------------------------------------------
    //  Décorateurs (optionnel, utile pour certaines libs)
    // ----------------------------------------------------------------------
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,

    // ----------------------------------------------------------------------
    //  Import/Export helpers
    // ----------------------------------------------------------------------
    "importsNotUsedAsValues": "remove",
    "preserveValueImports": false,
    "verbatimModuleSyntax": false,

    // ----------------------------------------------------------------------
    //  Alias de chemins (doit correspondre à vite.config.js)
    // ----------------------------------------------------------------------
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@common/*": ["./src/components/common/*"],
      "@stores/*": ["./src/stores/*"],
      "@composables/*": ["./src/composables/*"],
      "@assets/*": ["./src/assets/*"],
      "@utils/*": ["./src/utils/*"],
      "@directives/*": ["./src/directives/*"],
      "@router/*": ["./src/router/*"],
      "@views/*": ["./src/views/*"],
      "@types/*": ["./src/types/*"]
    },

    // ----------------------------------------------------------------------
    //  Types globaux
    // ----------------------------------------------------------------------
    "types": [
      "vite/client",
      "vitest/globals",
      "node"
    ],

    // ----------------------------------------------------------------------
    //  Options d'optimisation
    // ----------------------------------------------------------------------
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo"
  },

  // ==========================================================================
  //  Fichiers inclus dans la compilation
  // ==========================================================================
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "src/**/*.js",
    "src/**/*.jsx",
    "tests/**/*.ts",
    "tests/**/*.vue",
    "env.d.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ],

  // ==========================================================================
  //  Fichiers exclus de la compilation
  // ==========================================================================
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    ".vite-cache",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/*.spec.js",
    "**/*.test.js"
  ],

  // ==========================================================================
  //  Options spécifiques à Vue (vue-tsc)
  // ==========================================================================
  "vueCompilerOptions": {
    "target": 3,
    "strictTemplates": true,
    "strictProps": true,
    "strictCustomEvents": true,
    "strictSlots": true,
    "experimentalDisableTemplateSupport": false,
    "experimentalRfcs": {
      "skipTemplateCodegen": false
    }
  },

  // ==========================================================================
  //  Références aux autres configurations TypeScript
  // ==========================================================================
  "references": [
    { "path": "./tsconfig.node.json" }
  ]
}
