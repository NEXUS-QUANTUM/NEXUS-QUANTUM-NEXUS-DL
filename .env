# ==========================================================================
#  NexusDL 2.0 - Environment Variables
#  Fichier : .env
#  Description : Configuration complète de l'environnement pour NexusDL
#  Version : 2.0.0
#  Structure : Variables pour backend, frontend et Docker
# ==========================================================================

# --------------------------------------------------------------------------
#  APPLICATION
# --------------------------------------------------------------------------
APP_NAME=NexusDL
APP_VERSION=2.0.0
APP_DESCRIPTION="Moteur universel de téléchargement de scans"

# --------------------------------------------------------------------------
#  ENVIRONNEMENT & SERVEUR
# --------------------------------------------------------------------------
ENV=production
DEBUG=false
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8000

# --------------------------------------------------------------------------
#  BASE DE DONNÉES
# --------------------------------------------------------------------------
# SQLite (par défaut)
DATABASE_URL=sqlite:///./data/nexus.db

# Pour PostgreSQL (optionnel)
# DATABASE_URL=postgresql://user:password@postgres:5432/nexusdb

# Pour MySQL (optionnel)
# DATABASE_URL=mysql+pymysql://user:password@mysql:3306/nexusdb

# --------------------------------------------------------------------------
#  SÉCURITÉ & AUTHENTIFICATION
# --------------------------------------------------------------------------
# SECRET_KEY : 45ba66e9209d0fd079ca9f16fc03a831340a2f04d5c80e49c4bfafadc9214e1e
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --------------------------------------------------------------------------
#  CORS (Cross-Origin Resource Sharing)
# --------------------------------------------------------------------------
# Liste des origines autorisées (format JSON)
CORS_ORIGINS=["http://localhost:5173","http://localhost:80","http://localhost"]

# --------------------------------------------------------------------------
#  TÉLÉCHARGEMENTS & FICHIERS
# --------------------------------------------------------------------------
MAX_THREADS=10                 # Nombre de téléchargements parallèles
DOWNLOAD_TIMEOUT=30            # Timeout des requêtes (secondes)
DOWNLOAD_RETRY=3               # Nombre de tentatives en cas d'échec
DOWNLOAD_PATH=./data/downloads # Dossier de destination des CBZ
TEMP_PATH=./data/temp          # Dossier temporaire

# --------------------------------------------------------------------------
#  CACHE
# --------------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_MAX_SIZE=500             # Nombre maximum d'entrées en mémoire
CACHE_TTL=3600                 # Durée de vie des entrées (secondes)

# --------------------------------------------------------------------------
#  RATE LIMITING (limitation de débit)
# --------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100             # Requêtes maximum par fenêtre
RATE_LIMIT_WINDOW=60           # Fenêtre de temps (secondes)

# --------------------------------------------------------------------------
#  FRONTEND (Vite) - Variables utilisées lors du build
# --------------------------------------------------------------------------
VITE_API_BASE=/api
VITE_APP_VERSION=2.0.0
VITE_API_BACKEND_URL=http://backend:8000  # Utilisé pour le proxy de développement
VITE_BUILD_DATE=2025-01-15T00:00:00Z

# --------------------------------------------------------------------------
#  PLAYWRIGHT (pour les sites JS lourds)
# --------------------------------------------------------------------------
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright  # Utilisé dans Docker

# --------------------------------------------------------------------------
#  DOCKER & DÉPLOIEMENT
# --------------------------------------------------------------------------
# Variables utilisées par docker-compose pour la communication entre services
# (Définies directement dans docker-compose.yml ou ici)
# API_BACKEND_URL=http://backend:8000  # Déjà défini ci-dessus

# --------------------------------------------------------------------------
#  AUTRES OPTIONS (optionnel)
# --------------------------------------------------------------------------
# PREFER_HTTPS=true
# TRUSTED_PROXIES=["127.0.0.1"]
