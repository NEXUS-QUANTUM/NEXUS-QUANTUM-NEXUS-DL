 # ==========================================================================
#  NexusDL 2.0 - Variables d'environnement
#  Fichier : .env
#  Description : Configuration complète de l'application
#  Version : 2.0.0
#  À modifier selon votre environnement
# ==========================================================================

# --------------------------------------------------------------------------
#  1. ENVIRONNEMENT GÉNÉRAL
# --------------------------------------------------------------------------

# Environnement d'exécution (development, production, testing)
ENV=production

# Niveau de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Date de build (format ISO)
BUILD_DATE=2025-01-15T00:00:00Z


# --------------------------------------------------------------------------
#  2. APPLICATION
# --------------------------------------------------------------------------

# Nom de l'application
APP_NAME=NexusDL

# Version de l'application
APP_VERSION=2.0.0

# Description (pour l'API)
APP_DESCRIPTION="Moteur universel de téléchargement de scans"


# --------------------------------------------------------------------------
#  3. SERVEUR
# --------------------------------------------------------------------------

# Hôte d'écoute (0.0.0.0 pour toutes les interfaces)
HOST=0.0.0.0

# Port d'écoute
PORT=8000

# Mode debug (true/false) - NE PAS ACTIVER EN PRODUCTION
DEBUG=false

# Nombre de workers Uvicorn (par défaut: 1)
# WORKERS=4

# Chemin vers le fichier de logs
LOG_FILE=./logs/nexusdl.log


# --------------------------------------------------------------------------
#  4. BASE DE DONNÉES
# --------------------------------------------------------------------------

# URL de connexion à la base de données
# SQLite (par défaut)
DATABASE_URL=sqlite:///./data/nexus.db

# PostgreSQL (décommenter pour utiliser)
# DATABASE_URL=postgresql://user:password@localhost:5432/nexusdb

# MySQL (décommenter pour utiliser)
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/nexusdb


# --------------------------------------------------------------------------
#  5. SÉCURITÉ & AUTHENTIFICATION
# --------------------------------------------------------------------------

# Clé secrète pour JWT (À CHANGER EN PRODUCTION !)
# Génération : openssl rand -hex 32
SECRET_KEY=change-me-in-production-please-use-a-strong-secret-key-with-at-least-32-characters

# Algorithme de signature JWT
ALGORITHM=HS256

# Durée de vie des tokens (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Durée de vie des refresh tokens (jours)
REFRESH_TOKEN_EXPIRE_DAYS=7

# Sel pour le hachage des mots de passe (bcrypt)
# BCRYPT_ROUNDS=12


# --------------------------------------------------------------------------
#  6. CORS (Cross-Origin Resource Sharing)
# --------------------------------------------------------------------------

# Origines autorisées (format JSON array)
# Pour le développement : 
# CORS_ORIGINS=["http://localhost:5173","http://localhost:4173","http://localhost:80","http://localhost"]
# Pour la production : 
CORS_ORIGINS=["http://localhost","https://votre-domaine.com"]

# Méthodes autorisées (par défaut toutes)
# CORS_METHODS=["GET","POST","PUT","DELETE","OPTIONS","PATCH"]

# Headers autorisés
# CORS_HEADERS=["*"]


# --------------------------------------------------------------------------
#  7. TÉLÉCHARGEMENTS
# --------------------------------------------------------------------------

# Nombre maximum de téléchargements parallèles
MAX_THREADS=10

# Timeout des requêtes HTTP (secondes)
DOWNLOAD_TIMEOUT=30

# Nombre de tentatives en cas d'échec
DOWNLOAD_RETRY=3

# Dossier de destination des téléchargements
DOWNLOAD_PATH=./data/downloads

# Dossier temporaire (pour les téléchargements en cours)
TEMP_PATH=./data/temp

# Taille maximale d'un fichier CBZ (en Mo, 0 = illimité)
# MAX_CBZ_SIZE=0

# Qualité des images (1-100, 85 par défaut)
# IMAGE_QUALITY=85

# Redimensionner les images (true/false)
# RESIZE_IMAGES=false

# Taille maximale des images (pixels)
# MAX_IMAGE_DIMENSION=4000


# --------------------------------------------------------------------------
#  8. CACHE
# --------------------------------------------------------------------------

# Activer le cache (true/false)
CACHE_ENABLED=true

# Nombre maximum d'entrées dans le cache
CACHE_MAX_SIZE=500

# Durée de vie des entrées du cache (secondes)
CACHE_TTL=3600

# Activer la persistance du cache sur disque (true/false)
# CACHE_PERSIST=false

# Dossier du cache persistant
# CACHE_PATH=./data/cache


# --------------------------------------------------------------------------
#  9. RATE LIMITING (Limitation de débit)
# --------------------------------------------------------------------------

# Activer le rate limiting (true/false)
RATE_LIMIT_ENABLED=true

# Nombre maximum de requêtes par fenêtre
RATE_LIMIT_MAX=100

# Fenêtre de temps (secondes)
RATE_LIMIT_WINDOW=60

# Rate limiting pour les routes sensibles (login, etc.)
# RATE_LIMIT_AUTH_MAX=5
# RATE_LIMIT_AUTH_WINDOW=60


# --------------------------------------------------------------------------
#  10. PLAYWRIGHT (pour sites JS/Cloudflare)
# --------------------------------------------------------------------------

# Activer Playwright (true/false)
PLAYWRIGHT_ENABLED=true

# Headless mode (true/false)
PLAYWRIGHT_HEADLESS=true

# Timeout Playwright (millisecondes)
PLAYWRIGHT_TIMEOUT=30000

# Chemin vers le navigateur Chromium
# PLAYWRIGHT_CHROMIUM_PATH=/usr/bin/chromium-browser

# Nombre maximum de tentatives avec Playwright
# PLAYWRIGHT_MAX_RETRIES=3


# --------------------------------------------------------------------------
#  11. PROVIDERS
# --------------------------------------------------------------------------

# Activer tous les providers par défaut (true/false)
# PROVIDERS_ENABLED_BY_DEFAULT=true

# Providers à désactiver (liste séparée par des virgules)
# PROVIDERS_DISABLED=provider1,provider2

# Activer les providers NSFW (true/false)
# PROVIDERS_NSFW_ENABLED=false

# Timeout pour les providers (secondes)
# PROVIDERS_TIMEOUT=30

# User-Agent pour les requêtes des providers
# PROVIDERS_USER_AGENT="NexusDL/2.0 (compatible)"


# --------------------------------------------------------------------------
#  12. WEBSOCKET
# --------------------------------------------------------------------------

# Activer WebSocket (true/false)
WEBSOCKET_ENABLED=true

# Ping interval (secondes) pour garder la connexion active
WEBSOCKET_PING_INTERVAL=30

# Nombre maximum de connexions WebSocket simultanées
# WEBSOCKET_MAX_CONNECTIONS=100


# --------------------------------------------------------------------------
#  13. ADMIN / SUPERVISOR
# --------------------------------------------------------------------------

# Compte administrateur par défaut (créé au premier démarrage)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@nexusdl.local
# ADMIN_PASSWORD sera généré automatiquement si non défini
# ADMIN_PASSWORD=admin123

# Activer les endpoints d'administration (true/false)
# ADMIN_ENABLED=true


# --------------------------------------------------------------------------
#  14. FICHIERS & STOCKAGE
# --------------------------------------------------------------------------

# Taille maximale des fichiers uploadés (Mo)
# MAX_UPLOAD_SIZE=100

# Extensions autorisées pour l'upload
# ALLOWED_UPLOAD_EXTENSIONS=.cbz,.zip

# Nettoyer les fichiers temporaires automatiquement (true/false)
# AUTO_CLEANUP_TEMP=true

# Âge maximum des fichiers temporaires avant nettoyage (heures)
# TEMP_CLEANUP_AGE=24


# --------------------------------------------------------------------------
#  15. PERFORMANCE & OPTIMISATION
# --------------------------------------------------------------------------

# Activer la compression des réponses (true/false)
# COMPRESSION_ENABLED=true

# Niveau de compression (1-9, 6 par défaut)
# COMPRESSION_LEVEL=6

# Activer le pooling de connexions (true/false)
# CONNECTION_POOLING=true

# Taille du pool de connexions
# CONNECTION_POOL_SIZE=20

# Activer les métriques Prometheus (true/false)
# PROMETHEUS_ENABLED=false

# Port pour les métriques
# PROMETHEUS_PORT=9090


# --------------------------------------------------------------------------
#  16. DOCKER SPECIFIQUE
# --------------------------------------------------------------------------

# Utilisateur non-root pour Docker
# USER_UID=1000
# USER_GID=1000

# Nom du réseau Docker
# DOCKER_NETWORK=nexus_network


# --------------------------------------------------------------------------
#  17. SENTRY / ERROR REPORTING (optionnel)
# --------------------------------------------------------------------------

# DSN Sentry pour le monitoring des erreurs
# SENTRY_DSN=https://xxxxxxxxxxxxxx@sentry.io/123456

# Environnement Sentry
# SENTRY_ENVIRONMENT=production

# Taux d'échantillonnage des erreurs (0.0 - 1.0)
# SENTRY_SAMPLE_RATE=1.0


# --------------------------------------------------------------------------
#  18. EMAIL (pour notifications et réinitialisation de mot de passe)
# --------------------------------------------------------------------------

# Serveur SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@nexusdl.local
# SMTP_USE_TLS=true


# --------------------------------------------------------------------------
#  19. FRONTEND (configuration côté serveur pour le proxy)
# --------------------------------------------------------------------------

# URL du frontend pour les CORS et les redirections
# FRONTEND_URL=http://localhost

# URL de l'API pour le frontend (pour le proxy inversé)
# API_URL=http://backend:8000


# ==========================================================================
#  FIN DU FICHIER .env
# ==========================================================================
